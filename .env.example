GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=
GITHUB_OWNER=Mach-2
GITHUB_REPO=LARParts
GITHUB_BASE_BRANCH=staging
GITHUB_PRODUCTION_BRANCH=main

EMAIL_PROVIDER_API_KEY=
NOTIFICATION_EMAILS=
FROM_EMAIL=

SITE_URL=

# v1.0.1 runtime pages use published Supabase records on the release branch.
# Local development must use testing resources. Never put real values in Git.
APP_ENV=testing
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Separate credentials per environment; restrict each pair to its named bucket.
R2_ACCOUNT_ID=
R2_TEMPORARY_BUCKET=
R2_TEMPORARY_ACCESS_KEY_ID=
R2_TEMPORARY_SECRET_ACCESS_KEY=
R2_PUBLISHED_BUCKET=
R2_PUBLISHED_ACCESS_KEY_ID=
R2_PUBLISHED_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Independent non-secret resource pins, identical in both deployment contexts.
# Set actual project references and bucket names. All four buckets must differ.
BACKEND_TESTING_SUPABASE_REF=
BACKEND_PRODUCTION_SUPABASE_REF=
BACKEND_TESTING_TEMPORARY_BUCKET=
BACKEND_TESTING_PUBLISHED_BUCKET=
BACKEND_PRODUCTION_TEMPORARY_BUCKET=
BACKEND_PRODUCTION_PUBLISHED_BUCKET=

# Local testing migration/policy runner only. Never use a production URI here.
# Session pooler URI includes URL-encoded password. Not needed by application.
TEST_DATABASE_URL=
# Optional provider root certificate downloaded from testing Database Settings.
TEST_DATABASE_CA_FILE=.env-testing-ca.crt

# Release-branch image/verification endpoints and /submit-profile.
# Enable both submission flags for testing. Missing configuration returns 503.
IMAGE_INGESTION_ENABLED=false
IMAGE_CLEANUP_ENABLED=false

# Keep explicit deployment switches; production activation is a cutover gate.
VERIFIED_SUBMISSIONS_ENABLED=false
PUBLICATION_JOBS_ENABLED=false
# Generate a separate random 32-byte hex secret per environment. Never commit it.
VERIFICATION_TOKEN_SECRET=
# Comma-separated controlled testing inboxes; enforced for ALL new-flow mail.
TEST_EMAIL_ALLOWLIST=
# SITE_URL is the exact browser origin used for same-origin checks and R2 CORS.

# Turnstile site key may be rendered explicitly; secret is server-only.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
