---
interface Props {
	artist: {
		"First Name": string;
		"Last Name": string;
		"Home Park": string;
		Awards: string;
		Skills: string;
		"Member Since": string;
		Photo: string;
		Kingdom: string;
	};
}

const { artist } = Astro.props;

const fullName = `${artist["First Name"]} ${artist["Last Name"]}`.trim();
const normalizedPhotoPath = artist.Photo
	.replace(/^webpage\/public\//, "")
	.replace(/^\/+/, "");
const photoSrc = normalizedPhotoPath ? `/${normalizedPhotoPath}` : "";
const initials = [artist["First Name"], artist["Last Name"]]
	.map((name) => name.trim().charAt(0))
	.filter(Boolean)
	.join("");
---

<article class="artist-card">
	{
		photoSrc ? (
			<img class="artist-photo" src={photoSrc} alt={fullName} loading="lazy" />
		) : (
			<div class="artist-photo artist-photo-placeholder" aria-hidden="true">
				{initials}
			</div>
		)
	}

	<div class="artist-content">
		<div class="artist-main">
			<h2>{fullName}</h2>
			<p class="artist-park">
				{artist["Home Park"]}
				{artist.Kingdom && <span>{artist.Kingdom}</span>}
			</p>

			{artist.Awards && <p class="artist-awards">Awards: {artist.Awards}</p>}

			{artist.Skills && <p class="artist-specialties">{artist.Skills}</p>}
		</div>

		{artist["Member Since"] && <p class="artist-note">{artist["Member Since"]}</p>}
	</div>
</article>

<style>
	.artist-card {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		background: #fffdf6;
		border: 1px solid #d3c39a;
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 10px 30px rgba(30, 43, 32, 0.12);
	}

	.artist-photo {
		width: 180px;
		flex: 0 0 180px;
		height: 100%;
		min-height: 190px;
		object-fit: cover;
		background: #e6dcc0;
	}

	.artist-photo-placeholder {
		display: grid;
		place-items: center;
		font-size: 2rem;
		font-weight: 700;
		color: #1f4d3a;
	}

	.artist-content {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1rem 1.1rem;
		text-align: left;
	}

	.artist-content h2 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
	}

	.artist-main > p {
		margin: 0 0 0.75rem;
	}

	.artist-park {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.6rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: #1f4d3a;
	}

	.artist-park span::before {
		content: "—";
		margin-right: 0.6rem;
		color: #746646;
	}

	.artist-awards,
	.artist-specialties {
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.artist-note {
		margin: 0.75rem 0 0;
		text-align: right;
		font-size: 0.9rem;
		color: #8a671a;
	}

	@media (max-width: 560px) {
		.artist-card {
			flex-direction: column;
		}

		.artist-photo {
			width: 100%;
			flex-basis: auto;
			height: 240px;
			min-height: 0;
		}
	}
</style>
