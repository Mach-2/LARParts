---
import type { ArtistProfile } from "../data/artistProfile";

interface Props {
	artist: ArtistProfile;
}

const { artist } = Astro.props;

const initials = [artist.firstName, artist.lastName ?? ""]
	.map((name) => name.trim().charAt(0))
	.filter(Boolean)
	.join("");
const searchableText = [
	artist.displayName,
	artist.homePark,
	artist.kingdom,
	...artist.awards,
	...artist.skills,
	artist.memberSince,
	artist.biography,
	...Object.values(artist.contact),
]
	.filter(Boolean)
	.join(" ")
	.toLowerCase();
const normalizedAwards = artist.awards.join(" ").toLowerCase();
const normalizedSkills = artist.skills.join(" ").toLowerCase();
---

<article
	id={artist.id}
	class="artist-card"
	data-artist-card
	data-search={searchableText}
	data-kingdom={artist.kingdom}
	data-park={artist.homePark}
	data-awards={normalizedAwards}
	data-skills={normalizedSkills}
>
	{
		artist.photoUrl ? (
			<img class="artist-photo" src={artist.photoUrl} alt={artist.displayName} loading="lazy" />
		) : (
			<div class="artist-photo artist-photo-placeholder" aria-hidden="true">
				{initials}
			</div>
		)
	}

	<div class="artist-content">
		<div class="artist-main">
			<h2>{artist.displayName}</h2>
			{
				(artist.homePark || artist.kingdom) && (
					<p class="artist-park">
						{artist.homePark}
						{artist.kingdom && <span>{artist.kingdom}</span>}
					</p>
				)
			}

			{artist.awards.length > 0 && <p class="artist-awards">Titles: {artist.awards.join(", ")}</p>}

			{artist.skills.length > 0 && <p class="artist-specialties">{artist.skills.join(", ")}</p>}
		</div>

		{artist.memberSince && <p class="artist-note">{artist.memberSince}</p>}
	</div>
</article>

<style>
	.artist-card {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 1rem;
		overflow: hidden;
		box-shadow: 0 10px 30px var(--shadow-card);
	}

	.artist-photo {
		width: 180px;
		flex: 0 0 180px;
		height: 100%;
		min-height: 190px;
		object-fit: cover;
		background: var(--color-mark-bg);
	}

	.artist-photo-placeholder {
		display: grid;
		place-items: center;
		font-size: 2rem;
		font-weight: 700;
		color: var(--color-primary);
	}

	.artist-content {
		flex: 1 1 auto;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 1rem 1.1rem;
		text-align: left;
	}

	.artist-content h2 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
	}

	.artist-main > p {
		margin: 0 0 0.75rem;
	}

	.artist-park {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.6rem;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-primary);
	}

	.artist-park span::before {
		content: "—";
		margin-right: 0.6rem;
		color: var(--color-divider);
	}

	.artist-awards,
	.artist-specialties {
		font-size: 0.95rem;
		line-height: 1.6;
	}

	.artist-note {
		margin: 0.75rem 0 0;
		text-align: right;
		font-size: 0.9rem;
		color: var(--color-accent-dark);
	}

	@media (max-width: 560px) {
		.artist-card {
			flex-direction: column;
		}

		.artist-photo {
			width: 100%;
			flex-basis: auto;
			height: 240px;
			min-height: 0;
		}
	}
</style>
