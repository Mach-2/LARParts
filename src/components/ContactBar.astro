---
interface Props { message?: string; }
const { message = "Contact us at" } = Astro.props;
---

<footer class="contact-bar">
	<p>{message} <a href="mailto:larpingarts@gmail.com">larpingarts@gmail.com</a></p>
</footer>

<style>
	.contact-bar { padding: 0.85rem 1.25rem; text-align: center; font-size: 0.82rem; color: var(--color-muted); border-top: 1px solid var(--color-border); }
	.contact-bar p { margin: 0; }
	.contact-bar a { color: inherit; }
</style>
