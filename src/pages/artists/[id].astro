---
import View from '../../components/ArtistProfilePage.astro';
import DirectoryErrorPage from '../../components/DirectoryErrorPage.astro';
import {artistPage,publicPageResponse} from '../../server/public-pages';
import {publicPageEnvironment} from '../../server/page-environment';
export const prerender = false;
const page=await artistPage(Astro.params.id, {env:publicPageEnvironment()});
publicPageResponse(Astro.response,page.status);
---
{page.ok ? <View artist={page.data} /> : <DirectoryErrorPage status={page.status} />}
