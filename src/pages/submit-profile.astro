---
import {getSecret} from 'astro:env/server';
import ProfileSubmissionPage from '../components/ProfileSubmissionPage.astro';
import DirectoryErrorPage from '../components/DirectoryErrorPage.astro';
import {publicPageResponse} from '../server/public-pages';
import {loadPublicReadConfig} from '../server/config';
import {publicPageEnvironment} from '../server/page-environment';
export const prerender=false;
let enabled=false;
const siteKey=getSecret('TURNSTILE_SITE_KEY')??'';
try{
  loadPublicReadConfig(publicPageEnvironment());
  enabled=getSecret('VERIFIED_SUBMISSIONS_ENABLED')==='true'&&getSecret('IMAGE_INGESTION_ENABLED')==='true'&&!!siteKey;
}catch{}
publicPageResponse(Astro.response,enabled?200:503);
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('X-Content-Type-Options','nosniff');
Astro.response.headers.set('Content-Security-Policy',"frame-ancestors 'none'; base-uri 'self'; form-action 'self'");
---
{enabled?<ProfileSubmissionPage siteKey={siteKey}/>:<DirectoryErrorPage status={503}/>}
