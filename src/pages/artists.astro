---
import View from '../components/ArtistDirectoryPage.astro';
import DirectoryErrorPage from '../components/DirectoryErrorPage.astro';
import {directoryPage,publicPageResponse} from '../server/public-pages';
import {publicPageEnvironment} from '../server/page-environment';
export const prerender = false;
const page=await directoryPage({env:publicPageEnvironment()});
publicPageResponse(Astro.response,page.status);
---
{page.ok ? <View artists={page.data} /> : <DirectoryErrorPage status={page.status} />}
