---
import ArtistCard from "../components/ArtistCard.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ContactBar from "../components/ContactBar.astro";
import { artists } from "../data/artistProfile";
import { artistTitles } from "../data/artistTitles";
import "../styles/theme.css";

const directoryArtists = [...artists].sort((a, b) => {
	return a.displayName.localeCompare(b.displayName);
});
const titleFilters = artistTitles;
const skills = [
	...new Set(
		directoryArtists.flatMap((artist) => artist.skills),
	),
].sort((a, b) => a.localeCompare(b));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/design-nib-solid.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>All Artists | LARParts Directory</title>
	</head>
	<body>
		<SiteHeader current="directory" />

		<main class="page">
			<Breadcrumbs
				items={[
					{ label: "Directory", href: "/" },
					{ label: "All Artists" },
				]}
			/>

			<section class="hero">
				<h1>All Artists</h1>
				<p class="intro">
					Browse artists by park, kingdom, titles, and areas of expertise.
				</p>
			</section>

			<section class="filter-panel" aria-label="Filter artists">
				<div class="filter-field">
					<label for="artist-search">Search</label>
					<input id="artist-search" type="search" placeholder="Name, skill, park" data-filter-search />
				</div>

				<div class="filter-field">
					<label for="title-filter">Titles</label>
					<select id="title-filter" data-filter-title>
						<option value="">All titles</option>
						{titleFilters.map((title) => <option value={title.toLowerCase()}>{title}</option>)}
					</select>
				</div>

				<div class="skill-picker skill-picker-inline" data-skill-picker>
					<div class="filter-field">
						<label for="skill-picker-input">Skills</label>
						<input id="skill-picker-input" type="search" placeholder="Type to add skills" autocomplete="off" data-filter-skill-input />
					</div>

					<div class="skill-suggestions" data-skill-suggestions hidden>
						{
							skills.map((skill) => (
								<button type="button" value={skill.toLowerCase()} data-skill-suggestion>
									{skill}
								</button>
							))
						}
					</div>

					<div class="skill-chips" data-skill-chips hidden></div>
				</div>
			</section>

			<p class="filter-count" data-filter-count>
				Showing {directoryArtists.length} {directoryArtists.length === 1 ? "artist" : "artists"}
			</p>

			<p class="empty-state" data-empty-state hidden>
				No artists match those filters.
			</p>

			<section class="artist-grid" aria-label="All artists">
				{directoryArtists.map((artist) => <ArtistCard artist={artist} />)}
			</section>
		</main>
		<ContactBar />

		<script>
			// @ts-nocheck -- Legacy DOM filter script; type-hardening is outside Phase 1.
			const cards = Array.from(document.querySelectorAll("[data-artist-card]"));
			const searchInput = document.querySelector("[data-filter-search]");
			const titleSelect = document.querySelector("[data-filter-title]");
			const skillPicker = document.querySelector("[data-skill-picker]");
			const skillInput = document.querySelector("[data-filter-skill-input]");
			const skillSuggestionList = document.querySelector("[data-skill-suggestions]");
			const skillSuggestionButtons = Array.from(document.querySelectorAll("[data-skill-suggestion]"));
			const skillChips = document.querySelector("[data-skill-chips]");
			const countText = document.querySelector("[data-filter-count]");
			const emptyState = document.querySelector("[data-empty-state]");
			let selectedSkills = [];

			function getSkillLabel(value) {
				const button = skillSuggestionButtons.find((suggestion) => suggestion.value === value);
				return button?.textContent.trim() ?? value;
			}

			function renderSkillSuggestions() {
				const skillQuery = skillInput.value.trim().toLowerCase();
				let visibleCount = 0;

				for (const button of skillSuggestionButtons) {
					const isSelected = selectedSkills.includes(button.value);
					const isMatch = Boolean(skillQuery) && button.textContent.toLowerCase().includes(skillQuery);
					const isVisible = isMatch && !isSelected && visibleCount < 8;

					button.hidden = !isVisible;
					if (isVisible) {
						visibleCount += 1;
					}
				}

				skillSuggestionList.hidden = visibleCount === 0;
			}

			function renderSkillChips() {
				skillChips.replaceChildren();
				skillChips.hidden = selectedSkills.length === 0;

				for (const skill of selectedSkills) {
					const chip = document.createElement("button");
					chip.type = "button";
					chip.className = "skill-chip";
					chip.dataset.removeSkill = skill;
					chip.textContent = `${getSkillLabel(skill)} x`;
					skillChips.append(chip);
				}
			}

			function addSkill(skill) {
				if (!skill || selectedSkills.includes(skill)) {
					return;
				}

				selectedSkills = [...selectedSkills, skill];
				skillInput.value = "";
				updateArtists();
			}

			function removeSkill(skill) {
				selectedSkills = selectedSkills.filter((selectedSkill) => selectedSkill !== skill);
				updateArtists();
			}

			function updateArtists() {
				const query = searchInput.value.trim().toLowerCase();
				const title = titleSelect.value;
				let visibleCount = 0;

				for (const card of cards) {
					const matchesSearch = !query || card.dataset.search.includes(query);
					const matchesTitle = !title || card.dataset.awards.includes(title);
					const matchesSkills =
						selectedSkills.length === 0 ||
						selectedSkills.some((skill) => card.dataset.skills.includes(skill));
					const isVisible = matchesSearch && matchesTitle && matchesSkills;

					card.hidden = !isVisible;
					if (isVisible) {
						visibleCount += 1;
					}
				}

				countText.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? "artist" : "artists"}`;
				emptyState.hidden = visibleCount !== 0;
				renderSkillChips();
				renderSkillSuggestions();
			}

			for (const control of [searchInput, titleSelect]) {
				control.addEventListener("input", updateArtists);
				control.addEventListener("change", updateArtists);
			}

			skillInput.addEventListener("input", renderSkillSuggestions);
			skillInput.addEventListener("focus", renderSkillSuggestions);
			skillInput.addEventListener("keydown", (event) => {
				if (event.key !== "Enter") {
					return;
				}

				const firstSuggestion = skillSuggestionButtons.find((button) => !button.hidden);
				if (firstSuggestion) {
					event.preventDefault();
					addSkill(firstSuggestion.value);
				}
			});

			skillSuggestionList.addEventListener("click", (event) => {
				const button = event.target.closest("[data-skill-suggestion]");
				if (button) {
					addSkill(button.value);
				}
			});

			skillChips.addEventListener("click", (event) => {
				const button = event.target.closest("[data-remove-skill]");
				if (button) {
					removeSkill(button.dataset.removeSkill);
				}
			});

			document.addEventListener("click", (event) => {
				if (!skillPicker.contains(event.target)) {
					skillSuggestionList.hidden = true;
				}
			});
		</script>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family: var(--font-body);
		background:
			radial-gradient(circle at top left, var(--color-page-glow), transparent 36%),
			linear-gradient(180deg, var(--color-page-top) 0%, var(--color-page-bottom) 100%);
		color: var(--color-text);
	}

	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 2rem 1.25rem 4rem;
	}

	.hero {
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		color: var(--color-accent-dark);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 4vw, 4rem);
	}

	.intro {
		max-width: 45rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: var(--color-muted);
	}

	.artist-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		max-width: 1200px;
	}

	@media (max-width: 980px) {
		.artist-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
