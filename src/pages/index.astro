---
import artists from "../data/directory.json";

function slugify(value: string) {
	return value
		.toLowerCase()
		.trim()
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "");
}

const kingdomMap = new Map<string, number>();

for (const artist of artists) {
	const kingdom = artist.Kingdom?.trim();

	if (!kingdom) {
		continue;
	}

	kingdomMap.set(kingdom, (kingdomMap.get(kingdom) ?? 0) + 1);
}

const kingdoms = [...kingdomMap.entries()]
	.map(([name, artistCount]) => ({
		name,
		artistCount,
		href: `/kingdoms/${slugify(name)}/`,
		image: name === "Northern Lights" ? "/photos/NL_Heraldry1.png" : "",
	}))
	.sort((a, b) => a.name.localeCompare(b.name));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Northern Lights Artisan Directory</title>
	</head>
	<body>
		<main class="page">
			<section class="hero">
				<p class="eyebrow">Amtgard Artisan Directory</p>
				<h1>Artisan Directory</h1>
				<p class="intro">
					Choose a kingdom to browse artists by park, awards, and craft specialties.
				</p>
			</section>

			<section class="kingdom-grid" aria-label="Kingdoms">
				{
					kingdoms.map((kingdom) => (
						<a class="kingdom-card" href={kingdom.href}>
							<div class="kingdom-mark">
								{kingdom.image ? (
									<img src={kingdom.image} alt="" loading="lazy" />
								) : (
									<span>{kingdom.name.charAt(0)}</span>
								)}
							</div>

							<div class="kingdom-content">
								<p class="card-label">Kingdom</p>
								<h2>{kingdom.name}</h2>
								<p>
									{kingdom.artistCount}{" "}
									{kingdom.artistCount === 1 ? "artist" : "artists"}
								</p>
							</div>
						</a>
					))
				}
			</section>
		</main>
	</body>
</html>

<style>
	:global(body) {
		margin: 0;
		font-family: Georgia, serif;
		background:
			radial-gradient(circle at top left, rgba(130, 160, 116, 0.28), transparent 34%),
			linear-gradient(180deg, #f3f0e8 0%, #dce5d8 100%);
		color: #22202bff;
	}

	.page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 3rem 1.25rem 4rem;
	}

	.hero {
		margin-bottom: 2rem;
	}

	.eyebrow {
		margin: 0 0 0.5rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.85rem;
		color: #042f0fff;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 4vw, 4rem);
	}

	.intro {
		max-width: 45rem;
		font-size: 1.05rem;
		line-height: 1.6;
		color: #022b09ff;
	}

	.kingdom-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 1.5rem;
		max-width: 1200px;
	}

	.kingdom-card {
		display: grid;
		grid-template-columns: 88px minmax(0, 1fr);
		align-items: center;
		min-height: 148px;
		padding: 1.25rem;
		color: inherit;
		text-decoration: none;
		background: rgba(255, 255, 255, 0.86);
		border: 1px solid #102e19ff;
		border-radius: 8px;
		box-shadow: 0 10px 30px rgba(37, 36, 46, 0.08);
		transition:
			transform 160ms ease,
			box-shadow 160ms ease,
			border-color 160ms ease;
	}

	.kingdom-card:hover,
	.kingdom-card:focus-visible {
		transform: translateY(-3px);
		border-color: #35633b;
		box-shadow: 0 16px 36px rgba(37, 36, 46, 0.14);
	}

	.kingdom-card:focus-visible {
		outline: 3px solid #7b9f69;
		outline-offset: 4px;
	}

	.kingdom-mark {
		width: 72px;
		height: 88px;
		display: grid;
		place-items: center;
	}

	.kingdom-mark img {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.kingdom-mark span {
		font-size: 2.25rem;
		font-weight: 700;
		color: #204526ff;
	}

	.kingdom-content {
		min-width: 0;
	}

	.card-label {
		margin: 0 0 0.4rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-size: 0.75rem;
		color: #315438;
	}

	.kingdom-content h2 {
		margin: 0 0 0.45rem;
		font-size: 1.45rem;
		line-height: 1.15;
	}

	.kingdom-content p:last-child {
		margin: 0;
		color: #204526ff;
		font-size: 0.98rem;
	}

	@media (max-width: 560px) {
		.kingdom-card {
			grid-template-columns: 64px minmax(0, 1fr);
			padding: 1rem;
		}

		.kingdom-mark {
			width: 52px;
			height: 64px;
		}
	}
</style>
