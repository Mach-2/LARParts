---
import View from '../../components/KingdomDirectoryPage.astro';
import DirectoryErrorPage from '../../components/DirectoryErrorPage.astro';
import {kingdomPage,publicPageResponse} from '../../server/public-pages';
import {publicPageEnvironment} from '../../server/page-environment';
export const prerender = false;
const page=await kingdomPage(Astro.params.kingdom, {env:publicPageEnvironment()});
publicPageResponse(Astro.response,page.status);
---
{page.ok ? <View kingdom={page.data.kingdom} artists={page.data.artists} /> : <DirectoryErrorPage status={page.status} />}
